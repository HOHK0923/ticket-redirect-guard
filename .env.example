# === Kill Switch ===
GUARD_ENABLED=true

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Upstream Backend Server ===
UPSTREAM_URL=http://localhost:8080

# === Queue (대기열) ===
QUEUE_WAIT_MIN_SECONDS=3
# 큐 통과 토큰 유효 시간 (초)
QUEUE_PASS_TTL_SECONDS=300

# === Session ===
SESSION_TTL_SECONDS=600

# === Sensitive Endpoints (큐 통과 필수) ===
SENSITIVE_PATHS=/api/ticketing,/api/bookings,/api/payments

# === Redirect URL (큐 미통과 시 리다이렉트 대상) ===
REDIRECT_URL=/
