# === Kill Switch ===
GUARD_ENABLED=true

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Upstream Backend Server ===
UPSTREAM_URL=http://localhost:8080

# === Session Tracking ===
SESSION_IDLE_TIMEOUT_SECONDS=60

# === AI Feature Thresholds ===
# endpoint_burst_max_1s: 같은 API를 1초에 N번 이상 호출 시 의심
BURST_THRESHOLD=3
# req_interval_cv: 요청 간격 변동계수가 이 값 미만이면 의심 (낮을수록 기계적)
CV_THRESHOLD=0.15
# target_retry_count: 같은 대상을 N번 이상 재시도하면 의심
RETRY_THRESHOLD=3

# === Score Threshold ===
# score >= SCORE_HIGH → 302 redirect (차단)
SCORE_HIGH=60

# === Queue (대기열) ===
QUEUE_WAIT_MIN_SECONDS=3

# === Whitelist (comma-separated) ===
WHITELIST_IPS=127.0.0.1,10.0.0.0/8
WHITELIST_PATHS=/_guard/health,/_guard/metrics
WHITELIST_UAS=

# === Sensitive Endpoints (guard 적용 대상) ===
SENSITIVE_PATHS=/api/ticketing,/api/bookings,/api/payments

# === Redirect URL (봇 감지 시 리다이렉트 대상) ===
REDIRECT_URL=/
