# === Kill Switch ===
GUARD_ENABLED=true

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === Rate Limit Windows ===
RATE_WINDOW_SHORT=10
RATE_WINDOW_LONG=60
RATE_LIMIT_SHORT=15
RATE_LIMIT_LONG=60

# === Score Thresholds ===
SCORE_MID=30
SCORE_HIGH=70

# === Delay Range (ms) ===
DELAY_MIN_MS=100
DELAY_MAX_MS=800

# === Whitelist (comma-separated) ===
WHITELIST_IPS=127.0.0.1,10.0.0.0/8
WHITELIST_PATHS=/health,/metrics
WHITELIST_UAS=

# === Sensitive Paths (extra weight) ===
SENSITIVE_PATHS=/api/seats,/api/reserve,/api/pay,/api/checkout,/api/order

# === Redirect URL (bot detected → redirect here) ===
REDIRECT_URL=/
